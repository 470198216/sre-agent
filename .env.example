# OpenAI-compatible API（国内不要直连 api.openai.com）
# 示例：DeepSeek  https://api.deepseek.com/v1  +  deepseek-chat
#       百炼兼容   https://dashscope.aliyuncs.com/compatible-mode/v1  +  qwen-plus
# 本地中转若未开 TLS，必须用 http:// 而不是 https://
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# SSH: path to private key for the remote test host
SSH_PRIVATE_KEY_PATH=C:\Users\wenjin\.ssh\id_rsa
# Optional passphrase
# SSH_PASSPHRASE=

# Default max agent steps
MAX_AGENT_STEPS=8
